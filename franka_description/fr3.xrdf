format: "xrdf"
format_version: 1.0

kinematics:
  base_link: base
  ee_link: tool_frame
  link_names:
    - "base"
    - "fr3_link0"
    - "fr3_link1"
    - "fr3_link2"
    - "fr3_link3"
    - "fr3_link4"
    - "fr3_link5"
    - "fr3_link6"
    - "fr3_link7"
    - "fr3_link8"
    - "fr3_hand"
    - "tool_frame"
    - "fr3_leftfinger" 
    - "fr3_rightfinger"

  collision_link_names:
    - "fr3_link0"
    - "fr3_link1"
    - "fr3_link2"
    - "fr3_link3"
    - "fr3_link4"
    - "fr3_link5"
    - "fr3_link6"
    - "fr3_link7"
    - "fr3_link8"
    - "fr3_hand"
    - "fr3_leftfinger"
    - "fr3_rightfinger"

  mesh_link_names: 
    - "fr3_link0"
    - "fr3_link1"
    - "fr3_link2"
    - "fr3_link3"
    - "fr3_link4"
    - "fr3_link5"
    - "fr3_link6"
    - "fr3_link7"
    - "fr3_link8"
    - "fr3_hand"
    - "fr3_leftfinger"
    - "fr3_rightfinger"

tool_frames: ["tool_frame"]

default_joint_positions:
  fr3_joint1:   -0.0005
  fr3_joint2:   -0.016
  fr3_joint3:    0.0003
  fr3_joint4:   -0.0858
  fr3_joint5:   -0.0013
  fr3_joint6:    0.1349
  fr3_joint7:    0.1697
  fr3_finger_joint1: 0.0003
  fr3_finger_joint2: 0.0182

cspace:
  joint_names:
    - "fr3_joint1"
    - "fr3_joint2"
    - "fr3_joint3"
    - "fr3_joint4"
    - "fr3_joint5"
    - "fr3_joint6"
    - "fr3_joint7"
  acceleration_limits: [10,    10,    10,    10,    10,    10,    10   ]
  jerk_limits:         [10000, 10000, 10000, 10000, 10000, 10000, 10000]

collision:
  geometry: "auto_generated_collision_sphere_group"

self_collision:
  geometry: "auto_generated_collision_sphere_group"
  ignore:
    base_link:
      - "fr3_link1"
    fr3_link1:
      - "fr3_link2"
    fr3_link2:
      - "fr3_link3"
    fr3_link3:
      - "fr3_link4"
    fr3_link4:
      - "fr3_link5"
    fr3_link5:
      - "fr3_link6"
    fr3_link6:
      - "fr3_link7"
    fr3_link7:
      - "fr3_leftfinger"
      - "fr3_rightfinger"
      - "fr3_hand" 
    fr3_leftfinger:
      - "fr3_rightfinger"
      - "fr3_hand"
    fr3_link8:
      - "fr3_hand"
    fr3_hand:
      - "fr3_link8"
      - "fr3_link7"
      - "fr3_leftfinger"
      - "fr3_rightfinger"
      - "tool_frame"


geometry:
  auto_generated_collision_sphere_group:
    spheres:
      fr3_link1:
        - center: [ 0.000, -0.029, -0.040 ]
          radius: 0.075
        - center: [ 0.001, -0.012, -0.130 ]
          radius: 0.075
        - center: [ 0.000, -0.073,  0.000 ]
          radius: 0.09
